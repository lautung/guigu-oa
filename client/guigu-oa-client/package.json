{
  "name": "guigu-oa-client",
  "version": "0.1.0",
  "description": "云尚办公统一客户端",
  "type": "module",
  "engines": {
    "node": "^22.18.0"
  },
  "scripts": {
    "dev": "vite --port 9530",
    "build:prod": "npm run typecheck && vite build",
    "lint": "eslint \"src/**/*.{ts,vue}\" \"tests/**/*.{js,ts,vue}\" \"scripts/**/*.mjs\" playwright.config.ts playwright.api.config.ts vite.config.js",
    "typecheck": "vue-tsc --noEmit",
    "verify": "npm run verify:static && npm run test:unit",
    "verify:ci": "npm run verify:static && npm run test:unit:coverage",
    "verify:static": "npm run lint && npm run typecheck && npm run format:check && npm run check:docs && npm run check:legacy && npm run check:shell && npm run check:v-html && npm run check:contracts && npm run check:test-tooling",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\" \"tests/**/*.{js,ts}\" \"scripts/**/*.mjs\" playwright.config.ts playwright.api.config.ts vite.config.js eslint.config.js tsconfig.json .prettierrc.json ../../.github/workflows/ci.yml ../../.github/workflows/regression.yml ../../.github/workflows/security.yml",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"tests/**/*.{js,ts}\" \"scripts/**/*.mjs\" playwright.config.ts playwright.api.config.ts vite.config.js eslint.config.js tsconfig.json .prettierrc.json ../../.github/workflows/ci.yml ../../.github/workflows/regression.yml ../../.github/workflows/security.yml",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "coverage": "npm run test:unit:coverage",
    "test:e2e": "playwright test",
    "test:api": "playwright test --config=playwright.api.config.ts",
    "test:e2e:stack": "playwright test --config tests/e2e-stack/playwright.config.ts",
    "test:security": "playwright test --config tests/security/playwright.security.config.ts",
    "test:unit:watch": "vitest",
    "check:docs": "node scripts/check-module-map.mjs && node scripts/check-docs.mjs",
    "check:legacy": "node ../../scripts/check-legacy-terms.mjs",
    "check:shell": "node scripts/check-shell.mjs",
    "check:contracts": "node ../../scripts/check-contract-assertions.mjs",
    "check:test-tooling": "node scripts/check-test-tooling.mjs",
    "check:v-html": "node scripts/check-v-html.mjs"
  },
  "dependencies": {
    "@form-create/designer": "3.5.0",
    "@form-create/element-ui": "3.3.3",
    "@vue/shared": "3.5.41",
    "axios": "1.19.0",
    "element-plus": "2.14.4",
    "js-cookie": "3.0.8",
    "normalize.css": "7.0.0",
    "nprogress": "0.2.0",
    "pinia": "4.0.3",
    "quill": "2.0.3",
    "vue": "3.5.41",
    "vue-i18n": "^11.4.18",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "2.0.1",
    "@playwright/test": "^1.64.0",
    "@types/js-cookie": "^3.0.6",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "2.4.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "26.1.0",
    "prettier": "^3.9.10",
    "sass": "1.102.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "vue-tsc": "^3.3.13"
  }
}
