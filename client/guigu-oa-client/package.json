{
  "name": "guigu-oa-client",
  "version": "0.1.0",
  "description": "云尚办公统一客户端",
  "type": "module",
  "engines": {
    "node": "^22.18.0"
  },
  "scripts": {
    "dev": "vite --port 9530",
    "build:prod": "npm run typecheck && vite build",
    "lint": "eslint \"src/**/*.{ts,vue}\" \"tests/**/*.{js,ts,vue}\" playwright.config.ts vite.config.js",
    "typecheck": "vue-tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run format:check && npm run test:unit",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\" \"tests/**/*.{js,ts}\" playwright.config.ts vite.config.js eslint.config.js tsconfig.json .prettierrc.json ../../.github/workflows/ci.yml",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"tests/**/*.{js,ts}\" playwright.config.ts vite.config.js eslint.config.js tsconfig.json .prettierrc.json ../../.github/workflows/ci.yml",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@form-create/designer": "3.5.0",
    "@form-create/element-ui": "3.3.3",
    "@vue/shared": "3.5.41",
    "axios": "1.19.0",
    "element-plus": "2.14.4",
    "js-cookie": "3.0.8",
    "normalize.css": "7.0.0",
    "nprogress": "0.2.0",
    "pinia": "4.0.3",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "2.0.1",
    "@playwright/test": "^1.64.0",
    "@types/js-cookie": "^3.0.6",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "26.1.0",
    "prettier": "^3.9.10",
    "sass": "1.102.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "vue-tsc": "^3.3.13"
  }
}
