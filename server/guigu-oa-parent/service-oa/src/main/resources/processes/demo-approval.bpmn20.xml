<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://guigu-oa.com/demo">
  <process id="demoApproval" name="演示请假审批" isExecutable="true">
    <startEvent id="start" />
    <userTask id="bobReview" name="鲍勃审批" flowable:assignee="bob" />
    <endEvent id="end" />
    <sequenceFlow id="startToReview" sourceRef="start" targetRef="bobReview" />
    <sequenceFlow id="reviewToEnd" sourceRef="bobReview" targetRef="end" />
  </process>
</definitions>
