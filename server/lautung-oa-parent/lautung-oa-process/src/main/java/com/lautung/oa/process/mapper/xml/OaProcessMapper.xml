<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lautung.oa.process.mapper.OaProcessMapper">

    <!--
      审批行形状的唯一 owner（#181）：列、别名与 join 只写这一份，
      四条行取数（待处理回查、已发起、抄送我的行、已处理行）全部 include；
      两个计数（抄送我的、已处理）是 count 聚合，不引用本清单。
      ProcessVo 是唯一行类型；给行补一个字段只改这里。
      行本体存活过滤另有一份 owner：approvalRowLiveness（#198）。
    -->
    <sql id="approvalRowColumns">
        a.id,a.process_code,a.user_id,a.process_template_id,a.process_type_id,a.title,a.description,a.form_values,a.process_instance_id,a.status,a.create_time,a.update_time,
        d.name as name,
        b.name as processTemplateName,
        c.name as processTypeName
    </sql>

    <sql id="approvalRowJoins">
        left join sys_user d on a.user_id = d.id
        left join oa_process_template b on a.process_template_id = b.id
        left join oa_process_type c on a.process_type_id = c.id
    </sql>

    <!-- 行本体存活（#198）：手写 XML 不吃实体的 @TableLogic——它只进 MyBatis-Plus 生成的 SQL
         （ADR 0050），所以每条读都要自己 include 一次。只过滤审批行本体 a：join 侧的
         sys_user/模板/类型不禁删，删掉模板或用户后历史审批仍要显示当时的名字。 -->
    <sql id="approvalRowLiveness">a.is_deleted = 0</sql>

    <select id="selectProcessPage" resultType="com.lautung.oa.vo.process.ProcessVo">
        select
        <if test="vo.userId != null">
            /*+ INDEX(a idx_oa_process_user_create_time) */
        </if>
        <include refid="approvalRowColumns"/>
        from oa_process a
            <include refid="approvalRowJoins"/>
        <where>
            and <include refid="approvalRowLiveness"/>
            <if test="vo.keyword != null and vo.keyword != ''">
                and (a.process_code like CONCAT('%',#{vo.keyword},'%') or
                    a.title like CONCAT('%',#{vo.keyword},'%'))
            </if>
            <if test="vo.userId != null">
                and a.user_id = #{vo.userId}
            </if>
            <if test="vo.status != null and vo.status != ''">
                and a.status = #{vo.status}
            </if>
            <if test="vo.createTimeBegin != null and vo.createTimeBegin != ''">
                and a.create_time &gt;= #{vo.createTimeBegin}
            </if>
            <if test="vo.createTimeEnd != null and vo.createTimeEnd != ''">
                and a.create_time &lt;= #{vo.createTimeEnd}
            </if>
            <!-- 配置实例查询的数据范围（ADR 0053/0057）：部门列 = 发起人部门 d.dept_id，
                 本人列 = 发起人 a.user_id。查询侧只接受参数：#{} 绑定 + <foreach>，禁止 ${}。
                 scope 为 null 的是「已发起」路径，保持办事列表不带数据范围。
                 部门集为空且无本人行（且不是 unrestricted）时用 1 = 0 得零行，不是全部。 -->
            <if test="scope != null and !scope.unrestricted">
                <choose>
                    <when test="scope.deptIds.size() > 0">
                        and (d.dept_id in
                        <foreach collection="scope.deptIds" item="deptId" open="(" separator="," close=")">
                            #{deptId}
                        </foreach>
                        <if test="scope.selfUserId != null">
                            or a.user_id = #{scope.selfUserId}
                        </if>
                        )
                    </when>
                    <when test="scope.selfUserId != null">
                        and a.user_id = #{scope.selfUserId}
                    </when>
                    <otherwise>
                        and 1 = 0
                    </otherwise>
                </choose>
            </if>
        </where>
        <!-- 已发起与配置实例查询共用这条读：显式最新在前（#179），同刻由审批 id 决胜；
             已发起侧排序由 idx_oa_process_user_create_time 反向扫描支撑（V108，#185）。
             hint 只在 user_id 等值时注入：MySQL 8.4 优化器在 join 上下文里按 ref 成本选中
             幂等键索引（两者仅差 0.45），不认反向扫描的排序收益，单表形状则无此问题
             （EXPLAIN ANALYZE 实测 0.08ms vs 全量排序 19ms）；无 user_id 的配置实例查询
             用不上该索引，hint 自然被忽略，计划不变。
             存活过滤是残余谓词（#198）：索引刻意不含 is_deleted——把等值列插进去会破坏排序匹配；
             已删行数为 0 时反向扫描 + 残余过滤 + LIMIT 提前终止与加过滤前同形，故不另做 EXPLAIN 取证。 -->
        order by a.create_time desc, a.id desc
    </select>

    <!-- 待处理回查：按 businessKey 集合一次取回整页行，跳过已删审批行，服务层按引擎顺序重排。 -->
    <select id="selectRowsByIds" resultType="com.lautung.oa.vo.process.ProcessVo">
        select
            <include refid="approvalRowColumns"/>
        from oa_process a
            <include refid="approvalRowJoins"/>
        where <include refid="approvalRowLiveness"/>
        and a.id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 已处理计数：total=去重审批数（同一审批处理过多个节点只计一次，#186），原生 SQL 不走分页插件（#122 口径）。
         已处理谓词是动作类型白名单（#287，ADR 0049 修订）：action_type IN (APPROVE, REJECT) 才算处理，
         取代「除发起申请外全算处理」的负匹配——转办/催办/加签发起/撤回都不算处理。 -->
    <select id="countProcessedRows" resultType="long">
        select count(distinct r.process_id)
        from oa_process_record r
                 join oa_process a on a.id = r.process_id
        where r.operate_user_id = #{userId} and r.is_deleted = 0 and <include refid="approvalRowLiveness"/>
          and r.action_type in ('APPROVE', 'REJECT')
    </select>

    <!-- 已处理行：处理动作记录按审批去重（最近一次处理时间倒序、同刻由审批 id 决胜，#186），
         行与全局行形状同源，原生 LIMIT/OFFSET 分页（#122 口径）。
         聚合别名 p：共享列清单里 c 已被审批类型表占用。
         形状纪律（EXPLAIN ANALYZE 取证，#186）：窗口必须收在派生表内、先只聚合 id，
         载荷 join 只碰当页行——否则 17k 分组全体做 oa_process/sys_user 等四表 PK 回表后再排序
         （实测 p95 150→383ms）；聚合本身（该用户动作记录按审批分组取 max(create_time)）
         约 17ms 不可再省（is_deleted/action_type 过滤需读行，V109 索引供扫描与分组键）。
         极端情况（当页含已删审批行）页会缩一行，与回查跳过已删行的旧边界一致。 -->
    <select id="selectProcessedRows" resultType="com.lautung.oa.vo.process.ProcessVo">
        select
            <include refid="approvalRowColumns"/>
        from (select r.process_id, max(r.create_time) as last_time
              from oa_process_record r
              where r.operate_user_id = #{userId} and r.is_deleted = 0
                and r.action_type in ('APPROVE', 'REJECT')
              group by r.process_id
              order by last_time desc, r.process_id desc
              limit #{limit} offset #{offset}) p
                 join oa_process a on a.id = p.process_id
            <include refid="approvalRowJoins"/>
        where <include refid="approvalRowLiveness"/>
        order by p.last_time desc, a.id desc
    </select>

    <!-- 抄送我的计数：total=去重审批数（同一审批多种来源抄送只计一次），原生 SQL 不走分页插件（#122 口径）。
         授权表别名 g：共享列清单里 c 已被审批类型表占用。 -->
    <select id="countCarbonCopiedRows" resultType="long">
        select count(distinct g.process_id)
        from oa_process_cc g
                 join oa_process a on a.id = g.process_id
        where g.user_id = #{userId} and g.is_deleted = 0 and <include refid="approvalRowLiveness"/>
    </select>

    <!-- 抄送我的行：与全局行形状同源，原生 LIMIT/OFFSET 分页，最新在前。 -->
    <select id="selectCarbonCopiedRows" resultType="com.lautung.oa.vo.process.ProcessVo">
        select distinct
            <include refid="approvalRowColumns"/>
        from oa_process_cc g
                 join oa_process a on a.id = g.process_id
            <include refid="approvalRowJoins"/>
        where g.user_id = #{userId} and g.is_deleted = 0 and <include refid="approvalRowLiveness"/>
        order by a.create_time desc, a.id desc
        limit #{limit} offset #{offset}
    </select>
</mapper>
