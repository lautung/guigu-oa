<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>lautung-oa-parent</artifactId>
        <groupId>com.lautung</groupId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>lautung-oa-auth</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.lautung</groupId>
            <artifactId>lautung-oa-common</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lautung</groupId>
            <artifactId>lautung-oa-framework</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lautung</groupId>
            <artifactId>lautung-oa-security</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lautung</groupId>
            <artifactId>lautung-oa-model</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- 头像复用现有私有附件桶（avatar/{userId} 前缀），不新增桶（#254） -->
        <dependency>
            <groupId>com.lautung</groupId>
            <artifactId>lautung-oa-storage</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- 注册开关走 config 的只读端口，auth 不直连 sys_config（#253，ADR 0062） -->
        <dependency>
            <groupId>com.lautung</groupId>
            <artifactId>lautung-oa-config</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- 用户导出/导入只引 xlsx 读写（#259）：不引整套报表框架，POI 只落在 auth。 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.5.1</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- 本模块 4 个 mapper XML 物理在 src/main/java 的包目录内，随包一起打进 jar（全仓 8 个分属 auth/process） -->
        <resources>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.xml</include>
                </includes>
                <filtering>false</filtering>
            </resource>
        </resources>
        <testResources>
            <!-- 显式声明会覆盖 Maven 默认目录，先把默认 src/test/resources 保住 -->
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <!-- OpenApiExposureConfigTest 断言 profile YAML 的生效路径；YAML 实体属于装配模块
                 lautung-oa-server，这里只把 profile 配置复制到测试 classpath，不复制文件。 -->
            <testResource>
                <directory>${project.basedir}/../lautung-oa-server/src/main/resources</directory>
                <includes>
                    <include>application*.yml</include>
                </includes>
                <filtering>false</filtering>
            </testResource>
        </testResources>
    </build>
</project>
